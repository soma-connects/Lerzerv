<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talk to the backend (Supabase). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offline banner: know when the network drops (Board 1l). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Asked from the notification priming screen (Board 1i), Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- PROPOSAL: ACCESS_FINE_LOCATION and a foreground location service arrive with the
         real map (MapLibre) and live artisan positions; the demo uses sample coordinates. -->

    <!-- allowBackup off: the saved sign-in (Supabase session) must not be copied into cloud backups. -->
    <application
        android:name=".android.LezervApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lezerv">
        <activity
            android:name=".android.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Push notifications (Firebase Cloud Messaging). Firebase is set up in
             LezervApplication from local.properties, so there is no google-services.json. -->
        <service
            android:name=".android.LezervMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="jobs" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_lezerv" />
    </application>
</manifest>
